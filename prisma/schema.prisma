// prisma/schema.prisma

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider  = "postgresql"
}

// ─────────────────────────────────────────────
// AUTH
// ─────────────────────────────────────────────

model User {
  id              String    @id @default(cuid())
  name            String?
  firstName       String?
  lastName        String?
  email           String    @unique
  emailVerified   DateTime?
  image           String?
  password        String?
  role            Role      @default(USER)

  // Profile
  bio             String?
  username        String?   @unique
  phone           String?
  dateOfBirth     DateTime?
  gender          Gender?
  city            String?
  neighborhood    String?   // e.g. "Lekki Phase 1"

  // Socials
  instagramUrl    String?
  tiktokUrl       String?
  xUrl            String?
  snapchatUrl     String?

  // Preferences
  isProfilePublic Boolean   @default(true)
  notifyLinkUps   Boolean   @default(true)
  notifyEvents    Boolean   @default(true)
  notifyReviews   Boolean   @default(false)

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @default(now()) @updatedAt

  // Relations
  accounts        Account[]
  sessions        Session[]
  ratings         Rating[]
  comments        Comment[]
  posts           Post[]
  linkUpsCreated  LinkUp[]        @relation("LinkUpCreator")
  linkUpRequests  LinkUpRequest[] @relation("LinkUpRequestSender")
  savedPlaces     SavedPlace[]
}

enum Gender {
  MALE
  FEMALE
  NON_BINARY
  PREFER_NOT_TO_SAY
}

enum Role {
  USER
  ADMIN
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Add a dedicated token model for cleaner tracking
model VerificationToken {
  id        String   @id @default(cuid())
  otp       String   // 6-digit code
  email     String
  expiresAt DateTime
  attempts  Int      @default(0) // track wrong attempts
  createdAt DateTime @default(now())

  @@index([email])
}

// ─────────────────────────────────────────────
// PLACES
// ─────────────────────────────────────────────

model Place {
  id          String      @id @default(cuid())
  name        String
  slug        String      @unique
  description String
  categoryId  String
  address     String
  city        String      @default("Lagos")
  lat         Float
  lng         Float
  costLevel   Int         @default(2)  // 1=Budget, 2=Mid, 3=Premium
  view360Url  String?
  isPublished Boolean     @default(false)
  isFeatured  Boolean     @default(false)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  category    Category     @relation(fields: [categoryId], references: [id])
  images      PlaceImage[]
  menuItems   MenuItem[]
  ratings     Rating[]
  comments    Comment[]
  events      Event[]
  linkUps     LinkUp[]
  savedBy     SavedPlace[]
}

model Category {
  id          String  @id @default(cuid())
  name        String
  slug        String  @unique
  icon        String  // tabler icon name, e.g. "ti-glass-cocktail"
  image       String? // cover image url
  description String?
  order       Int     @default(0)

  places Place[]
}

model PlaceImage {
  id        String  @id @default(cuid())
  url       String
  alt       String?
  isPrimary Boolean @default(false)
  placeId   String

  place Place @relation(fields: [placeId], references: [id], onDelete: Cascade)
}

model MenuItem {
  id      String  @id @default(cuid())
  name    String
  price   Int     // in Naira
  placeId String

  place Place @relation(fields: [placeId], references: [id], onDelete: Cascade)
}

// ─────────────────────────────────────────────
// EVENTS
// ─────────────────────────────────────────────

enum EventCategory {
  MUSIC
  FOOD
  ART
  TECH
  SPORTS
  FASHION
  COMEDY
  OTHER
}

enum TicketType {
  FREE
  PAID
}

model Event {
  id            String        @id @default(cuid())
  title         String
  slug          String        @unique
  description   String
  category      EventCategory
  imageUrl      String?
  ticketType    TicketType    @default(FREE)
  ticketPrice   Int?          // in Naira, null if free
  ticketUrl     String?       // link to buy ticket
  startTime     DateTime
  endTime       DateTime?
  address       String?
  city          String        @default("Lagos")
  lat           Float?
  lng           Float?
  isPublished   Boolean       @default(false)
  isFeatured    Boolean       @default(false)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  placeId       String?
  place         Place?        @relation(fields: [placeId], references: [id])
  comments      Comment[]
  linkUps       LinkUp[]
}

// ─────────────────────────────────────────────
// SOCIAL
// ─────────────────────────────────────────────

model Rating {
  id        String   @id @default(cuid())
  score     Float    // 1.0 – 5.0
  userId    String
  placeId   String
  createdAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  place Place @relation(fields: [placeId], references: [id], onDelete: Cascade)

  @@unique([userId, placeId])
}

model Comment {
  id        String   @id @default(cuid())
  body      String
  userId    String
  placeId   String?
  eventId   String?
  createdAt DateTime @default(now())

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  place Place? @relation(fields: [placeId], references: [id], onDelete: Cascade)
  event Event? @relation(fields: [eventId], references: [id], onDelete: Cascade)
}

// ─────────────────────────────────────────────
// WAITLIST
// ─────────────────────────────────────────────

model WaitlistEntry {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())
}


// ─────────────────────────────────────────────
// BLOG POST
// ─────────────────────────────────────────────
model Post {
  id          String      @id @default(cuid())
  title       String
  slug        String      @unique
  excerpt     String
  content     String      // rich text stored as HTML or markdown
  coverImage  String?
  category    PostCategory @default(LIFESTYLE)
  readTime    Int         @default(5) // in minutes
  isPublished Boolean     @default(false)
  isFeatured  Boolean     @default(false)
  publishedAt DateTime?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  authorId    String
  author      User        @relation(fields: [authorId], references: [id])

  tags        PostTag[]
}

enum PostCategory {
  LIFESTYLE
  FOOD
  NIGHTLIFE
  TRAVEL
  CULTURE
  EVENTS
  GUIDES
}

model PostTag {
  id     String @id @default(cuid())
  name   String
  slug   String @unique
  posts  Post[]
}

enum LinkUpStatus {
  OPEN      // accepting requests
  CLOSED    // creator closed it
  FULL      // max capacity reached
}

enum LinkUpRequestStatus {
  PENDING
  ACCEPTED
  DECLINED
}

// ─────────────────────────────────────────────
// BLOG POST
// ─────────────────────────────────────────────

model LinkUp {
  id           String        @id @default(cuid())
  title        String        // e.g. "Looking for people to vibe with"
  description  String?       // optional note
  date         DateTime      // when they're going
  maxSize      Int           @default(5) // max group size including creator
  status       LinkUpStatus  @default(OPEN)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  creatorId    String
  creator      User          @relation("LinkUpCreator", fields: [creatorId], references: [id])

  placeId      String?
  place        Place?        @relation(fields: [placeId], references: [id])

  eventId      String?
  event        Event?        @relation(fields: [eventId], references: [id])

  requests     LinkUpRequest[]
  shareSocials Boolean  @default(false) // creator shares their socials
}

model LinkUpRequest {
  id            String               @id @default(cuid())
  message       String?              // optional message from requester
  status        LinkUpRequestStatus  @default(PENDING)
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  linkUpId      String
  linkUp        LinkUp  @relation(fields: [linkUpId], references: [id], onDelete: Cascade)

  senderId      String
  sender        User    @relation("LinkUpRequestSender", fields: [senderId], references: [id])
  shareSocials  Boolean  @default(false) // requester shares their socials
}

model SavedPlace {
  id String @id @default(cuid())

  userId  String
  placeId String

  createdAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  place Place @relation(fields: [placeId], references: [id], onDelete: Cascade)

  @@unique([userId, placeId])
  @@index([userId])
  @@index([placeId])
}
