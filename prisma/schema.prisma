// prisma/schema.prisma

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

// ─────────────────────────────────────────────
// AUTH
// ─────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  name          String?
  firstName     String?
  lastName      String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  password      String?   // credentials users only — null for Google users
  role          Role      @default(USER)
  accounts      Account[]
  sessions      Session[]
  ratings       Rating[]
  comments      Comment[]
  createdAt     DateTime  @default(now())
}

enum Role {
  USER
  ADMIN
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─────────────────────────────────────────────
// PLACES
// ─────────────────────────────────────────────

model Place {
  id          String      @id @default(cuid())
  name        String
  slug        String      @unique
  description String
  categoryId  String
  address     String
  city        String      @default("Lagos")
  lat         Float
  lng         Float
  costLevel   Int         @default(2)  // 1=Budget, 2=Mid, 3=Premium
  view360Url  String?
  isPublished Boolean     @default(false)
  isFeatured  Boolean     @default(false)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  category    Category     @relation(fields: [categoryId], references: [id])
  images      PlaceImage[]
  menuItems   MenuItem[]
  ratings     Rating[]
  comments    Comment[]
  events      Event[]
}

model Category {
  id          String  @id @default(cuid())
  name        String
  slug        String  @unique
  icon        String  // tabler icon name, e.g. "ti-glass-cocktail"
  image       String? // cover image url
  description String?
  order       Int     @default(0)

  places Place[]
}

model PlaceImage {
  id        String  @id @default(cuid())
  url       String
  alt       String?
  isPrimary Boolean @default(false)
  placeId   String

  place Place @relation(fields: [placeId], references: [id], onDelete: Cascade)
}

model MenuItem {
  id      String  @id @default(cuid())
  name    String
  price   Int     // in Naira
  placeId String

  place Place @relation(fields: [placeId], references: [id], onDelete: Cascade)
}

// ─────────────────────────────────────────────
// EVENTS
// ─────────────────────────────────────────────

enum EventCategory {
  MUSIC
  FOOD
  ART
  TECH
  SPORTS
  FASHION
  COMEDY
  OTHER
}

enum TicketType {
  FREE
  PAID
}

model Event {
  id            String        @id @default(cuid())
  title         String
  slug          String        @unique
  description   String
  category      EventCategory
  imageUrl      String?
  ticketType    TicketType    @default(FREE)
  ticketPrice   Int?          // in Naira, null if free
  ticketUrl     String?       // link to buy ticket
  startTime     DateTime
  endTime       DateTime?
  address       String?
  city          String        @default("Lagos")
  lat           Float?
  lng           Float?
  isPublished   Boolean       @default(false)
  isFeatured    Boolean       @default(false)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  placeId       String?
  place         Place?        @relation(fields: [placeId], references: [id])
  comments      Comment[]
}

// ─────────────────────────────────────────────
// SOCIAL
// ─────────────────────────────────────────────

model Rating {
  id        String   @id @default(cuid())
  score     Float    // 1.0 – 5.0
  userId    String
  placeId   String
  createdAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  place Place @relation(fields: [placeId], references: [id], onDelete: Cascade)

  @@unique([userId, placeId])
}

model Comment {
  id        String   @id @default(cuid())
  body      String
  userId    String
  placeId   String?
  eventId   String?
  createdAt DateTime @default(now())

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  place Place? @relation(fields: [placeId], references: [id], onDelete: Cascade)
  event Event? @relation(fields: [eventId], references: [id], onDelete: Cascade)
}

// ─────────────────────────────────────────────
// WAITLIST
// ─────────────────────────────────────────────

model WaitlistEntry {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())
}
